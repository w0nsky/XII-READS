---
import BaseLayout from "./BaseLayout.astro";
import { Image } from 'astro:assets';

const {frontmatter} = Astro.props;
const images = import.meta.glob('../media/books/*.{jpg,jpeg,webp}', {
  eager: true,
  import: 'default'
});
const imageKey = Object.keys(images).find((key) =>
  key.includes(`/${frontmatter.cover}.`)
);
const image = imageKey ? images[imageKey] : undefined;
---
<BaseLayout pageTitle={frontmatter.title}>
  <div class="container">
    <div class="header">
      {image && <Image src={image} alt={frontmatter.name} />}
      <div class="header__content">
        <h1>{frontmatter.name}</h1>
        <span class="header__info">{frontmatter.rate}/10</span>
        <span class="header__info">{frontmatter.month}</span>
      </div>
    </div>
    <slot />
  </div>
</BaseLayout>

<style>
  img{
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: relative;
  }
  .header{
    position: relative;
    box-shadow: 12px 12px 0px var(--black);
    height: 450px;
  }
  h1{
    background-color: #fff;
    padding: 20px;
    font-family: var(--font-h);
    text-transform: uppercase;
  }
  .header__content{
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 0;
    display: flex;
    gap:32px;
    align-items: end;
  }

  .header__info{
    background-color: #fff;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: fit-content;
    font-weight: 800;
    text-transform: uppercase;
  }
</style>
